
# ==========================================
# MiBici Project - Git Ignore
# ==========================================

# ------------------------------------------
# 1. Data files
# ------------------------------------------
data/raw/**
data/interim/**
data/processed/**
data/external/**

# Keep directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Large data files
*.parquet
*.feather

# ------------------------------------------
# 2. MLflow - Experiment Tracking
# ------------------------------------------

# SQLite tracking database
mlflow.db
mlflow.db-shm
mlflow.db-wal
mlflow.db-*

# MLflow runs and artifacts
mlruns/
mlartifacts/

# ------------------------------------------
# 3. Trained ML Models
# ------------------------------------------
models/**
!models/.gitkeep

# Serialized models
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.keras
*.pt
*.pth
*.onnx

# ------------------------------------------
# 4. Environment Variables and Credentials
# ------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key

# ------------------------------------------
# 5. Python
# ------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Python caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# 6. Jupyter Notebooks
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# 7. IDE and OS Files
# ------------------------------------------
.vscode/
.idea/

.DS_Store
Thumbs.db

# ------------------------------------------
# 8. Logs and Temporary Files
# ------------------------------------------
*.log
tmp/
temp/