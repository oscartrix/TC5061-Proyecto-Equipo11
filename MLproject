name: mibici-equipo11

python_env: python_env.yaml

# Fechas, rutas, semillas, URI de tracking e hiperparámetros por default se leen de mi_bici/config.py.
entry_points:
  ingest:
    parameters:
      start: {type: str, default: ""}
      end: {type: str, default: ""}
    command: "python -m mi_bici.dataset --start {start} --end {end}"

  features:
    command: "python -m mi_bici.features"

  # Hiperparámetros: -P <nombre>=<valor>, con los nombres de MODEL_DEFAULTS en config.py.
  # Lista de modelos e hiperparámetros: python -m mi_bici.modeling.train --list-models
  # Ejemplo: mlflow run . -e train -P question=p1 -P model=ridge -P alpha=0.5
  train:
    parameters:
      question: {type: str, default: "p1"}
      model: {type: str, default: "baseline"}
    command: "python -m mi_bici.modeling.train --question {question} --model {model}"

  # Búsqueda con nested runs sobre SEARCH_GRIDS de config.py
  search:
    parameters:
      question: {type: str, default: "p1"}
      model: {type: str, default: "ridge"}
    command: "python -m mi_bici.modeling.search --question {question} --model {model}"

  register:
    parameters:
      question: {type: str, default: "p1"}
    command: "python -m mi_bici.modeling.register --question {question}"

  # Reentrena el champion de P2 con datos hasta train_end y lo registra con alias retrain
  retrain:
    parameters:
      train_end: {type: str, default: "2026-08-31"}
      alias: {type: str, default: "retrain"}
    command: "python -m mi_bici.modeling.retrain --train-end {train_end} --alias {alias}"

  # Compara @champion contra otra versión de P2 sobre un periodo que ninguna vio al entrenar
  ab_test:
    parameters:
      challenger_alias: {type: str, default: "retrain-jun"}
      start: {type: str, default: "2026-07-01"}
      end: {type: str, default: "2026-09-30"}
      name: {type: str, default: "ab_test"}
    command: "python -m mi_bici.monitoring.ab_testing --challenger-alias {challenger_alias} --start {start} --end {end} --name {name}"

  predict:
    parameters:
      question: {type: str, default: "p1"}
      features_path: {type: path}
      predictions_path: {type: str}
    command: "python -m mi_bici.modeling.predict --question {question} --features-path {features_path} --predictions-path {predictions_path}"

  evaluate:
    parameters:
      question: {type: str, default: "p1"}
    command: "python -m mi_bici.modeling.evaluate --question {question}"

  main:
    command: "python -m mi_bici.dataset && python -m mi_bici.features"
