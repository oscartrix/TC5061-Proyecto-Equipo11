name: mibici-equipo11

python_env: python_env.yaml

# Fechas, rutas y URI de tracking se leen de mi_bici/config.py
entry_points:
  ingest:
    command: "python -m mi_bici.dataset"

  features:
    command: "python -m mi_bici.features"

  train:
    parameters:
      question:
        type: str
        default: "all"
    command: "python -m mi_bici.modeling.train --question {question} --tracking-uri http://127.0.0.1:5000"

  main:
    command: "python -m mi_bici.dataset && python -m mi_bici.features && python -m mi_bici.modeling.train"
